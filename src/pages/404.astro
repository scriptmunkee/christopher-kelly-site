---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found | Christopher Kelly" description="This page doesn't exist." noindex>
  <section class="nf" data-hero>
    <p class="eyebrow">404</p>
    <h1 class="h1">This page isn't here.</h1>
    <p class="hero-body" style="margin:0">It may have moved, or the link may be wrong.</p>
    <div class="hero-btns" style="justify-content:center;margin-top:.5rem">
      <a class="btn" href="/">👉 Back to the homepage</a>
      <a class="btn btn-ghost" href="/services/">See services →</a>
    </div>
  </section>
</Base>
