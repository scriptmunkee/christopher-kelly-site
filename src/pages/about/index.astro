---
import Portrait from '../../components/Portrait.astro';
import Base from '../../layouts/Base.astro';
import Faq from '../../components/Faq.astro';
import BookCall from '../../components/BookCall.astro';
import { site } from '../../data/site';
import { getCaseStudies } from '../../lib/caseStudies';
import { getPosts } from '../../lib/blog';
import { personSchema, businessSchema, profilePageSchema, breadcrumbSchema, faqSchema } from '../../lib/schema';

const U = site.url;
const updated = new Date('2026-10-25');
const title = 'About Christopher Kelly | Enterprise AI SEO Consultant';
const description = 'Christopher Kelly is a senior, hands-on enterprise AI SEO consultant in Newcastle upon Tyne, getting multi-location brands cited by AI. Book a call.';

const strip = [
  { n: '15+', l: 'luxury properties delivered' },
  { n: '4', l: 'continents' },
  { n: '12', l: 'named clients across four sectors' },
  { n: 'UK', l: 'based, working globally' },
];

const timeline = [
  { d: '', t: 'Law firm and dental clients', p: 'Including Stowe Family Law, Simpson Millar, Fulham Road Dental and Direct Dental.' },
  { d: 'Feb 2024 to Mar 2025', t: 'Web3 and crypto SEO', p: 'Audits, strategy and content for brands including Bankless, RedStone Finance and Mezo, through a partner agency.' },
  { d: 'Multi-year, to now', t: 'Global luxury hotel group', p: 'Multi-year SEO and AI search across 15+ properties on four continents. Named on request.' },
  { d: 'Oct 2025', t: 'Founds Ascend Digital Marketing Ltd', p: 'The consultancy behind this site, Companies House number 16822903.' },
  { d: '2026', t: 'Local SEO automation goes live', p: 'Audits that took most of a day now generate in about two minutes.' },
];

const principles = [
  { t: 'Senior and hands-on', p: 'The person who audits your brand writes the recommendations and ships the changes. No juniors, no handoffs.' },
  { t: 'Built for approval chains', p: 'Briefs approvers can sign off quickly, changes batched by risk, and work done inside your CMS and Jira.' },
  { t: 'Entities first', p: 'I make your brand, locations and offers unambiguous to machines before chasing individual prompts.' },
  { t: 'Measured in money', p: 'Mentions and citations tracked every month and tied to traffic, bookings and revenue.' },
];

const stats = [
  { n: '15+', c: 'luxury hotel and resort properties, multi-year', s: 'Global hotel group, named on request' },
  { n: '4', c: 'continents covered by that portfolio', s: 'Same portfolio, named on request' },
  { n: '12', c: 'named clients across legal, dental and web3', s: 'Permission to name confirmed' },
  { n: '~2 min', c: 'to generate a full local SEO audit, down from most of a day', s: 'Documented: team guide, Aug 2026' },
];

const clientGroups = [
  { tag: 'Luxury hospitality', names: [{ n: 'Global luxury hotel group', w: 'Named on request. 15+ properties, multi-year.' }],
    line: `That portfolio work is the backbone of my approach as an <a class="inl" href="${U}/services/ai-seo-consultant-hospitality/">AI SEO Consultant for Hospitality</a>.` },
  { tag: 'Legal', names: [{ n: 'Stowe Family Law' }, { n: 'Simpson Millar' }],
    line: `Regulated, high-trust work like this shapes how I operate as an <a class="inl" href="${U}/services/ai-seo-consultant-solicitors/">AI SEO Consultant for Solicitors</a>.` },
  { tag: 'Dental', names: [{ n: 'Fulham Road Dental' }, { n: 'Direct Dental' }],
    line: `Both are London private practices, and they inform my work as an <a class="inl" href="${U}/services/ai-seo-consultant-dentists/">AI SEO Consultant for Dentists</a>.` },
  { tag: 'Web3 and fintech', names: [
      { n: 'Bankless', w: 'Content briefs, keyword targeting, backlink analysis' },
      { n: 'RedStone Finance', w: 'Oracle and DeFi content, competitor pages' },
      { n: 'Mezo', w: 'SEO strategy' },
      { n: 'Thesis', w: 'SEO strategy' },
      { n: 'Trojan', w: 'Audit and strategy' },
      { n: 'Crestal', w: 'Strategy' },
      { n: 'Bando', w: 'Audit and strategy' },
      { n: 'Bity', w: 'Audit, 404s and URL structure' },
    ],
    line: `Delivered through a partner agency, this is the grounding for my work as an <a class="inl" href="${U}/services/ai-seo-consultant-fintech/">AI SEO Consultant for Fintech</a>.` },
];

const toolkit = {
  build: ['n8n (self-hosted)', 'APIs and webhooks', 'MCP servers', 'Claude', 'A heading-scoring Chrome extension I built'],
  platforms: ['Google Business Profile', 'Yext', 'Adobe Analytics', 'Google Search Console', 'DataForSEO', 'Jira'],
};

const profileFacts = [
  ['Name', 'Christopher Kelly'],
  ['Role', 'Enterprise AI SEO Consultant'],
  ['Company', 'Ascend Digital Marketing Ltd, Companies House number 16822903'],
  ['Based in', 'Newcastle upon Tyne, UK'],
  ['Works', 'Worldwide, remotely'],
  ['Specialisms', 'AI search optimisation, entity and knowledge graph optimisation, multi-location and local SEO, SEO automation'],
  ['Sectors', 'Luxury hospitality, multi-location brands, legal, dental, fintech and web3'],
  ['LinkedIn', site.linkedinUrl ? `<a class="inl" href="${site.linkedinUrl}" rel="me noopener">linkedin.com/in/christopher-kelly-seo</a>` : '[PLACEHOLDER]'],
  ['Website', `<a class="inl" href="${U}/">christopher-kelly.co.uk</a>`],
];

const recordFacts = [
  ['Enterprise delivery', 'Multi-year SEO and AI search for a global luxury hotel group, 15+ properties on four continents (named on request)'],
  ['AI search result', `A resort's destination page <a class="inl" href="${U}/blog/resort-ai-overview-case-study/">cited by Google's AI Overview</a> as both the definition and the getting-there source`],
  ['Automation', `n8n workflows that generate <a class="inl" href="${U}/case-studies/local-seo-automation-luxury-hotel-portfolio/">local SEO audits in about two minutes</a> and write approved fixes back to listings`],
  ['Named clients', 'Stowe Family Law, Simpson Millar, Fulham Road Dental, Direct Dental, Bankless, RedStone Finance, Mezo, Thesis, Trojan, Crestal, Bando, Bity'],
  ['Method', `<a class="inl" href="${U}/services/seo-ai-visibility-audit/">Baseline across the AI engines</a>, fix entities, build answer-first content, then measure mentions and citations monthly`],
  ['Experience', 'A long-standing background in SEO and marketing operations'],
];

const faqs = [
  { q: 'Who is Christopher Kelly?',
    a: 'Christopher Kelly is a senior, hands-on enterprise AI SEO consultant based in Newcastle upon Tyne, UK. He gets multi-location and multi-brand businesses understood, cited and recommended by ChatGPT, Gemini, Perplexity, Copilot and Google AI Mode. His background is multi-year SEO delivery for a global luxury hotel group across 15+ properties, plus work for law firms, dental practices and web3 brands.' },
  { q: 'Where are you based, and do you work internationally?',
    a: "I'm based in Newcastle upon Tyne in North East England and work with brands worldwide. My longest-running enterprise work covers properties on four continents, so time zones, regional teams and local markets are part of the job. Calls, workshops and reviews all run remotely, and the deliverables fit straight into your existing tools." },
  { q: 'Will I work with you or with a team?',
    a: "You work with me directly. The person who audits your brand is the person who writes the recommendations, builds the automation and checks the results. I don't hand work down to juniors. For large production jobs, I work alongside your in-house team or agency, setting the direction and reviewing what ships." },
  { q: 'What kind of businesses do you work with?',
    a: "Mostly multi-location and multi-brand enterprises: hotel and resort groups, branch networks and businesses with many sites, profiles and approval layers. I've also worked with law firms, dental practices and crypto and fintech brands. The common thread is a brand that needs AI to describe it accurately in every market it serves." },
  { q: 'Why AI SEO rather than traditional SEO?',
    a: "Because buyers now ask AI assistants for recommendations, and those answers name a few brands instead of listing ten links. Traditional SEO still matters, since AI leans on the same pages, profiles and entities. My work covers both, but it's judged on whether AI mentions, cites and recommends you, not just where you rank." },
];

const caseStudies = await getCaseStudies();
const casePosts = (await getPosts()).filter((p) => p.data.category === 'Case Studies');
const cases = [
  ...caseStudies.map((c) => ({ href: `/case-studies/${c.id}/`, label: c.data.eyebrow, t: c.data.title, p: c.data.standfirst, stat: `${c.data.headline[0].n} ${c.data.headline[0].l}` })),
  ...casePosts.map((p) => ({ href: `/blog/${p.id}/`, label: 'Entity case study', t: p.data.title, p: p.data.standfirst, stat: "Cited by Google's AI Overview as the definition source" })),
].slice(0, 2);

const cover = [
  { e: '🤖', t: 'How AI describes you today', p: 'What ChatGPT, Gemini and Google AI say about your brand.' },
  { e: '🔎', t: 'Who gets named instead', p: 'The questions where a competitor wins.' },
  { e: '🧠', t: 'Entity gaps', p: 'Where machines get confused about who you are.' },
  { e: '📍', t: 'Location data health', p: 'Drift across your site, profiles and listings.' },
  { e: '⏱️', t: 'What to automate', p: 'The repetitive work worth taking off your team.' },
  { e: '🗺️', t: "What I'd fix first", p: 'A short, prioritised list.' },
];

const schema = [
  personSchema(),
  businessSchema(),
  profilePageSchema({ path: '/about/', name: title, description, modified: updated }),
  breadcrumbSchema([
    { name: 'Home', path: '/' },
    { name: 'About', path: '/about/' },
  ]),
  faqSchema(faqs),
];
---
<Base title={title} description={description} active="about" schema={schema} hasBookSection>

  <section class="hero-band" data-hero>
    <nav class="crumb" aria-label="Breadcrumb">
      <ol>
        <li><a href="/">Home</a></li>
        <li class="sep" aria-hidden="true">/</li>
        <li aria-current="page">About</li>
      </ol>
    </nav>
    <div class="hero hero-tight">
      <div>
        <p class="eyebrow">About</p>
        <h1 class="h1">Christopher Kelly, Enterprise AI SEO Consultant</h1>
        <p class="hero-sub">Senior, hands-on AI SEO for multi-location brands. Not another agency layer.</p>
        <p class="hero-body">I help multi-location and multi-brand organisations get understood, cited and recommended by ChatGPT, Gemini, Perplexity and Google AI. You work with me directly, from the first audit to the last fix.</p>
        <div class="hero-btns">
          <a class="btn" href="#book">👉 Book a 15 minute call</a>
          <a class="btn btn-ghost" href="/case-studies/">See the case studies →</a>
        </div>
      </div>
      <div class="hero-media">
        <div class="photo photo-hero">
          <Portrait variant="hero" eager />
        </div>
        <div class="ai-card" role="img" aria-label="An AI answer describing Christopher Kelly as an enterprise AI SEO consultant in Newcastle upon Tyne">
          <span class="ai-head" aria-hidden="true"><span class="ai-dot"></span>AI answer</span>
          <p class="ai-prompt" aria-hidden="true">Who is Christopher Kelly?</p>
          <p class="ai-ans" aria-hidden="true">An <strong>enterprise AI SEO consultant</strong> in Newcastle upon Tyne, UK, who gets multi-location brands cited and recommended by AI.</p>
          <span class="ai-tag" aria-hidden="true">Source: christopher-kelly.co.uk</span>
        </div>
      </div>
    </div>
    <ul class="ab-strip" aria-label="At a glance">
      {strip.map((s) => <li><span class="ab-strip-n">{s.n}</span><span class="ab-strip-l">{s.l}</span></li>)}
    </ul>
  </section>

  <!-- STORY -->
  <section class="sec bg-white" id="story" aria-labelledby="h-story">
    <div class="wrap ab-story">
      <div class="ab-story-c">
        <p class="eyebrow">My story</p>
        <h2 class="h2" id="h-story">From Marketing Ops to AI Search</h2>
        <p>I come from a long-standing background in SEO and marketing operations. The job has changed more in the last two years than in all the years before, because buyers now ask AI for a recommendation before they search.</p>
        <p>For years I've delivered SEO for a global luxury hotel group across 15+ properties on four continents: seasonal and experience pages, FAQ systems, Google Business Profiles and tracking how AI describes each property. Every change clears brand, legal and regional teams, so I know how to ship inside a big organisation.</p>
        <p>Alongside that, I've worked with law firms, dental practices and crypto and fintech brands. Those sectors taught me how AI treats regulated, high-trust businesses, where a wrong answer costs more than a lost click.</p>
        <p>I build my own tooling too. n8n workflows, API integrations and browser tools take the repetitive work off people, and my <a class="inl" href="/case-studies/local-seo-automation-luxury-hotel-portfolio/">local SEO automation case study</a> shows what that's worth to an enterprise team.</p>
        <p>I run the consultancy through Ascend Digital Marketing Ltd, based in Newcastle upon Tyne, and work with brands worldwide.</p>
      </div>
      <ol class="tl" aria-label="Career timeline">
        {timeline.map((i) => (
          <li class="tl-i">
            {i.d && <span class="tl-d">{i.d}</span>}
            <span class="tl-t">{i.t}</span>
            <span class="tl-p">{i.p}</span>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- HOW I WORK -->
  <section class="sec bg-cream" id="how-i-work" aria-labelledby="h-how">
    <div class="wrap">
      <div class="shead">
        <p class="eyebrow">How I work</p>
        <h2 class="h2" id="h-how">Not Another Agency Layer</h2>
      </div>
      <div class="ab-principles">
        {principles.map((p, i) => (
          <div class="svc lift">
            <span class="svc-n">{String(i + 1).padStart(2, '0')}</span>
            <h3 class="svc-t">{p.t}</h3>
            <p class="svc-d">{p.p}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- TRACK RECORD -->
  <section class="sec bg-black" id="experience" aria-labelledby="h-exp">
    <div class="wrap">
      <div class="shead">
        <p class="eyebrow">Track record</p>
        <h2 class="h2 h2-w" id="h-exp">The Work Behind The Claims</h2>
      </div>
      <div class="stat-grid">
        {stats.map((s) => <div class="stat-d"><span class="stat-n">{s.n}</span><span class="stat-c">{s.c}</span><span class="stat-s">{s.s}</span></div>)}
      </div>
      <p class="sub sub-w ab-exp-line">The two-minute audit, and the hours and money behind it, are worked through in the <a class="inl ab-on-dark" href="/case-studies/local-seo-automation-luxury-hotel-portfolio/">local SEO automation case study</a>.</p>
    </div>
  </section>

  <!-- CLIENTS -->
  <section class="sec bg-white" id="clients" aria-labelledby="h-clients">
    <div class="wrap">
      <div class="shead">
        <p class="eyebrow">Clients</p>
        <h2 class="h2" id="h-clients">Brands I've Worked With</h2>
        <p class="sub">Named with permission. The hotel group stays named on request.</p>
      </div>
      <div class="ab-clients">
        {clientGroups.map((g) => (
          <div class={`ab-cg${g.names.length > 3 ? ' ab-cg-wide' : ''}`}>
            <span class="tag tag-indigo">{g.tag}</span>
            <ul class="ab-names">
              {g.names.map((n) => <li><span class="ab-name">{n.n}</span>{n.w && <span class="ab-work">{n.w}</span>}</li>)}
            </ul>
            <p class="ab-cg-line" set:html={g.line} />
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CASE STUDIES -->
  {cases.length > 0 && (
    <section class="sec bg-cream" aria-labelledby="h-cases">
      <div class="wrap-1100">
        <div class="shead">
          <p class="eyebrow">Work</p>
          <h2 class="h2" id="h-cases">Selected Case Studies</h2>
        </div>
        <div class="ab-cases">
          {cases.map((c) => (
            <a class="post-card" href={c.href}>
              <span class="label">{c.label}</span>
              <h3 class="post-card-t">{c.t}</h3>
              <p class="post-card-p">{c.p}</p>
              <p class="ab-case-stat">{c.stat}</p>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- TOOLKIT -->
  <section class="sec bg-white" id="toolkit" aria-labelledby="h-tools">
    <div class="wrap-1100">
      <div class="shead">
        <p class="eyebrow">Toolkit</p>
        <h2 class="h2" id="h-tools">What I Build With</h2>
      </div>
      <div class="ab-tools">
        <div><p class="cs-gk">Build</p><ul class="chips ab-chips">{toolkit.build.map((t) => <li class="chip">{t}</li>)}</ul></div>
        <div><p class="cs-gk">Platforms</p><ul class="chips ab-chips">{toolkit.platforms.map((t) => <li class="chip">{t}</li>)}</ul></div>
      </div>
    </div>
  </section>

  <!-- FACTS -->
  <section class="sec bg-cream" id="facts" aria-labelledby="h-facts">
    <div class="wrap-1100">
      <div class="shead">
        <p class="eyebrow">For people and AI assistants</p>
        <h2 class="h2" id="h-facts">Christopher Kelly: The Facts</h2>
        <p class="sub">The short, accurate version. If another source disagrees, this page is the one kept up to date.</p>
      </div>
      <div class="ab-facts">
        <table class="ab-ft">
          <caption>Profile</caption>
          <tbody>{profileFacts.map(([k, v]) => <tr><th scope="row">{k}</th><td set:html={v} /></tr>)}</tbody>
        </table>
        <table class="ab-ft">
          <caption>Track record</caption>
          <tbody>{recordFacts.map(([k, v]) => <tr><th scope="row">{k}</th><td set:html={v} /></tr>)}</tbody>
        </table>
      </div>
      <p class="cs-small">Last updated <time datetime={updated.toISOString().slice(0, 10)}>25 October 2026</time></p>
    </div>
  </section>

  <!-- FAQ -->
  <section class="sec bg-white" id="faq" aria-labelledby="h-faq">
    <div class="wrap-800">
      <div class="shead">
        <p class="eyebrow">FAQ</p>
        <h2 class="h2" id="h-faq">Questions About Working With Me</h2>
      </div>
      <Faq items={faqs} />
    </div>
  </section>

  <BookCall
    heading="Let's See Where You Stand<br>In AI Search"
    sub="One call, direct with me. You leave knowing how AI describes your brand today and what I'd fix first."
    cover={cover}
    threeCol
  />

</Base>
